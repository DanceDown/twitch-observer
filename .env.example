COMPOSE_PROJECT_NAME=twitch_observer
TZ=Europe/Berlin

# PostgreSQL
POSTGRES_DB=twitch_observer
POSTGRES_USER=twitch_observer
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Discord
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# Twitch API validation
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# General
LOG_LEVEL=DEBUG

# Twitch user cache and metadata refresh
TWITCH_USER_CACHE_MEMORY_SIZE=20000
TWITCH_PATTERN_COMPILE_CACHE_SIZE=1024
TWITCH_CHAT_METADATA_LOOKUP_TIMEOUT_SECONDS=3
TWITCH_METADATA_REFRESH_INTERVAL_SECONDS=43200
TWITCH_METADATA_REFRESH_REQUEST_SPACING_SECONDS=0 # remove to maximize space between requests (e.g. 3 batches over 6 minutes would have a spacing of 2 minutes)
TWITCH_METADATA_REFRESH_BATCH_SIZE=100
TWITCH_LIVE_MONITOR_POLL_INTERVAL_SECONDS=30
TWITCH_LIVE_MONITOR_BATCH_SIZE=100
TWITCH_LIVE_MONITOR_REFRESH_ON_STARTUP=true

# Twitch token refresh behavior
TWITCH_ACCOUNT_TOKEN_REFRESH_SKEW_SECONDS=30
TWITCH_APP_ACCESS_TOKEN_REFRESH_SKEW_SECONDS=60

# Twitch device flow polling
TWITCH_DEVICE_FLOW_POLL_INTERVAL_SECONDS=2
TWITCH_DEVICE_FLOW_SLOWDOWN_STEP_SECONDS=5

# Discord presence background updater
DISCORD_PRESENCE_POLL_INTERVAL_SECONDS=60
DISCORD_PRESENCE_WATCHDOG_INTERVAL_SECONDS=60
DISCORD_PRESENCE_STALE_AFTER_SECONDS=180
DISCORD_PRESENCE_UPDATE_TIMEOUT_SECONDS=15
DISCORD_PRESENCE_LOOKBACK_MINUTES=5
DISCORD_PRESENCE_MESSAGE_LIMIT=50
DISCORD_PRESENCE_MAX_STATUS_LENGTH=120

# Discord result and audit delivery retries
DISCORD_DELIVERY_MAX_ATTEMPTS=3
DISCORD_TRACKING_DELIVERY_STOP_TIMEOUT_SECONDS=30

# Twitch chat message write batching
TWITCH_CHAT_PROCESSING_QUEUE_SIZE=10000
TWITCH_CHAT_PROCESSING_WORKERS=6
TWITCH_CHAT_PROCESSING_STOP_TIMEOUT_SECONDS=30
TWITCH_MESSAGE_WRITE_BATCH_SIZE=50
TWITCH_MESSAGE_WRITE_FLUSH_INTERVAL_SECONDS=0.25
TWITCH_MESSAGE_WRITE_SPOOL_PATH=.data/message-write-spool.json

# Discord write reply candidates
DISCORD_WRITE_REPLY_CANDIDATE_MAX_AGE_MINUTES=1440
DISCORD_WRITE_REPLY_CANDIDATE_LIMIT=25

# IRC startup synchronization
IRC_BOOTSTRAP_CONNECT_TIMEOUT_SECONDS=15
IRC_CHANNEL_RESYNC_INTERVAL_SECONDS=300
TWITCH_IRC_CONNECTION_CHECK_INTERVAL_SECONDS=10
TWITCH_IRC_RECONNECT_INITIAL_DELAY_SECONDS=1
TWITCH_IRC_RECONNECT_MAX_DELAY_SECONDS=60
